# Copy this file to .env and fill in your key. The .env file is git-ignored.

# Required. Create an "API destination" in Lunch Flow (Destinations page) to get one.
LUNCHFLOW_API_KEY=

# Optional. Where the Lunch Flow API lives.
# LUNCHFLOW_BASE_URL=https://www.lunchflow.app/api/v1

# Optional. Serve sample data instead of calling Lunch Flow (same as `npm run mock`).
# LUNCHFLOW_MOCK=1

# Optional. Network settings. The server binds to localhost only by default.
# HOST=127.0.0.1
# PORT=3000

# Optional. How long fetched balances are reused before Lunch Flow is asked again.
# The Refresh button always bypasses the cache.
# CACHE_TTL_SECONDS=300

# Optional. If set, the page asks for this password before showing balances.
# MONETA_PASSWORD=
# Optional. Set to 1 to refuse to serve balances until MONETA_PASSWORD is set.
# MONETA_REQUIRE_PASSWORD=1

# Where per-account settings made in the app are kept when self-hosting.
# MONETA_DATA_DIR=data

# Optional. Upstash Redis over REST, so settings made in the app are shared across
# devices. On Vercel these are added automatically when you create an Upstash
# Redis store under Storage. Without them on Vercel, settings live in the browser.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
